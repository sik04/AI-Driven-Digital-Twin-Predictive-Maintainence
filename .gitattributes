# Set default behavior to automatically detect text files and force LF line endings
* text=auto eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
experiments/phase08_exploratory_v2/*.csv.gz filter=lfs diff=lfs merge=lfs -text
experiments/phase08_exploratory_v3/*.csv.gz filter=lfs diff=lfs merge=lfs -text
experiments/**/*.csv.gz filter=lfs diff=lfs merge=lfs -text
